{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow State Schema",
  "description": "Shared state across news generation workflows for coordination and deduplication",
  "type": "object",
  "properties": {
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last state update"
    },
    "lastEveningAnalysis": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last evening analysis generation"
    },
    "lastRealtimeMonitor": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp of last realtime monitor check"
    },
    "lastArticleGenerator": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last article generator run"
    },
    "realtimeArticlesSinceEvening": {
      "type": "array",
      "description": "Realtime articles generated since last evening analysis",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Article slug (e.g., 2026-02-13-budget-debate)"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When article was generated"
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Main topics covered in article"
          },
          "synthesizedInEvening": {
            "type": "boolean",
            "description": "Whether this was synthesized in evening analysis"
          },
          "languages": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Languages generated for this article"
          }
        },
        "required": ["slug", "timestamp", "topics"]
      }
    },
    "mcpQueryCache": {
      "type": "object",
      "description": "Cache of MCP queries to avoid duplicate calls (2-hour TTL)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "result": { "type": "object" },
          "timestamp": { "type": "string", "format": "date-time" },
          "ttl": { "type": "number", "description": "TTL in seconds", "default": 7200 }
        }
      }
    },
    "eveningAnalysisMetrics": {
      "type": "object",
      "description": "Metrics from last evening analysis run",
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date of the evening analysis"
        },
        "languagesGenerated": {
          "type": "integer",
          "description": "Number of language versions generated",
          "minimum": 1,
          "maximum": 14
        },
        "avgQualityScore": {
          "type": "number",
          "description": "Average quality score across all languages",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "avgAnalyticalDepth": {
          "type": "number",
          "description": "Average analytical depth score",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "historicalContextPresent": {
          "type": "integer",
          "description": "Number of articles with historical context"
        },
        "internationalComparisons": {
          "type": "integer",
          "description": "Number of articles with international comparisons"
        }
      }
    }
  },
  "required": ["lastUpdated"]
}
