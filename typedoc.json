{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/browser",
    "scripts"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.typedoc.json",
  "out": "api",
  "name": "Riksdagsmonitor Intelligence Platform — API Documentation",
  "readme": "docs/API_README.md",
  "plugin": [
    "typedoc-plugin-mdn-links"
  ],
  "exclude": [
    "**/lib/**",
    "**/node_modules/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts",
    "**/*.cjs"
  ],
  "blockTags": [
    "@author",
    "@callback",
    "@category",
    "@default",
    "@defaultValue",
    "@deprecated",
    "@description",
    "@enum",
    "@example",
    "@file",
    "@gdpr",
    "@hidden",
    "@intelligence",
    "@internal",
    "@license",
    "@link",
    "@module",
    "@osint",
    "@override",
    "@param",
    "@returns",
    "@remarks",
    "@risk",
    "@see",
    "@security",
    "@since",
    "@throws",
    "@type",
    "@typedef",
    "@typeParam",
    "@version",
    "@business",
    "@marketing",
    "@market",
    "@revenue",
    "@growth",
    "@audience",
    "@competitive",
    "@stakeholder",
    "@kpi",
    "@performance",
    "@compliance",
    "@pipeline",
    "@dashboard",
    "@visualization",
    "@datasource",
    "@parliament",
    "@political"
  ],
  "categorizeByGroup": true,
  "searchInComments": true,
  "searchInDocuments": true,
  "navigationLinks": {
    "🏠 Home": "https://riksdagsmonitor.com",
    "📦 GitHub": "https://github.com/Hack23/riksdagsmonitor",
    "🛡️ ISMS": "https://github.com/Hack23/ISMS-PUBLIC",
    "🏛️ CIA Platform": "https://github.com/Hack23/cia"
  },
  "sidebarLinks": {
    "🏛️ Architecture": "https://github.com/Hack23/riksdagsmonitor/blob/main/ARCHITECTURE.md",
    "🔒 Security Architecture": "https://github.com/Hack23/riksdagsmonitor/blob/main/SECURITY_ARCHITECTURE.md",
    "🛡️ Threat Model": "https://github.com/Hack23/riksdagsmonitor/blob/main/THREAT_MODEL.md",
    "📊 Data Model": "https://github.com/Hack23/riksdagsmonitor/blob/main/DATA_MODEL.md",
    "🔄 Flowchart": "https://github.com/Hack23/riksdagsmonitor/blob/main/FLOWCHART.md",
    "📈 State Diagram": "https://github.com/Hack23/riksdagsmonitor/blob/main/STATEDIAGRAM.md",
    "🧠 Mindmap": "https://github.com/Hack23/riksdagsmonitor/blob/main/MINDMAP.md",
    "💼 SWOT Analysis": "https://github.com/Hack23/riksdagsmonitor/blob/main/SWOT.md",
    "🚀 Future Architecture": "https://github.com/Hack23/riksdagsmonitor/blob/main/FUTURE_ARCHITECTURE.md",
    "🔮 Future Security": "https://github.com/Hack23/riksdagsmonitor/blob/main/FUTURE_SECURITY_ARCHITECTURE.md",
    "📋 Secure Dev Policy": "https://github.com/Hack23/ISMS-PUBLIC/blob/main/Secure_Development_Policy.md"
  },
  "excludePrivate": false,
  "excludeProtected": false,
  "excludeInternal": false,
  "excludeReferences": false,
  "includeVersion": true,
  "hideGenerator": false,
  "cleanOutputDir": true,
  "sort": [
    "source-order",
    "alphabetical"
  ],
  "kindSortOrder": [
    "Module",
    "Namespace",
    "Class",
    "Interface",
    "TypeAlias",
    "Enum",
    "Function",
    "Variable"
  ],
  "visibilityFilters": {
    "protected": true,
    "private": true,
    "inherited": true,
    "@alpha": false,
    "@beta": false
  },
  "groupReferencesByType": true,
  "suppressCommentWarningsInDeclarationFiles": true
}
