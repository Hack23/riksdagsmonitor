# Only fail npm audit for high/critical severity vulnerabilities.
# Moderate-severity ajv ReDoS (GHSA-2g4f-4pwh-qvx6) in eslint's internal
# config validation is a known upstream issue - eslint@10.0.0 still uses
# ajv@6 which cannot be overridden without breaking eslint.
# Production dependencies have 0 vulnerabilities (npm audit --omit=dev).
audit-level=high
